# OAuth 2.0 refresh token with bookmark.read, tweet.read, users.read and
# offline.access scopes. The app exchanges it for an access token on every run.
X_REFRESH_TOKEN=
X_CLIENT_ID=

# The latest refresh token is stored here so token rotation survives restarts.
# Defaults to /tmp/karakeep-x-importer/refresh-token outside Docker.
# X_TOKEN_FILE=/tmp/karakeep-x-importer/refresh-token

# Only set this for a confidential OAuth client. Native/public PKCE clients do
# not have a client secret.
X_CLIENT_SECRET=

# The URL of your Karakeep instance (without /api/v1).
KARAKEEP_URL=http://localhost:3000

# Create this in Karakeep under Settings > API Keys.
KARAKEEP_API_KEY=
